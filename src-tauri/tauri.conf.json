{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpookyOmni",
  "version": "0.1.0",
  "identifier": "com.spookynetwork.omni",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpookyNetwork :: Sovereign Nexus",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "transparent": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.notion.com https://dexscreener.com; frame-src https://dexscreener.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
